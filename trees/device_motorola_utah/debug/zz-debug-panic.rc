# DEBUG ONLY. Installed into /vendor/etc/init/ only when the build is run with
# UTAH_DEBUG_PANIC=1 (see device.mk). Never ship this.
#
# Why: r3 and r4 hang with nothing on USB, a forced restart wipes the kernel console buffer, and
# so there is no log. If boot has not completed 600 s after early-init, dump logcat, the process
# list with kernel wait channels and the vendor boot milestones (/proc/bootprof) into the kernel
# log, then panic the kernel (SysRq c). The phone reboots by itself, the console log survives in
# pstore, and our recovery can pull it: adb pull /sys/fs/pstore/console-ramoops-0
# Needs SELinux permissive for the test boot (boot with androidboot.selinux=permissive).
#
# History: the first version used a bare "$(...)" (init rejects it). The second fired at 150 s,
# which is too early for a first boot after a data wipe, and wrote "ps" in one write(2) to
# /dev/kmsg, which only takes about 1 KB per write, so its output was lost. Now each line is
# written separately.
#
# NOTE on syntax: init expands "$" in rc commands ("${prop}" or "$$" for a literal dollar), and a
# bare "$(...)" is rejected as deprecated property syntax, which makes the whole command fail
# before it runs. So the shell variable below is written "$$l" (init turns it into "$l").
on early-init
    write /proc/sys/kernel/sysrq 1
    exec_background - root root -- /system/bin/sh -c "sleep 600; getprop sys.boot_completed | grep -q 1 || { echo ==== DEBUG-PANIC logcat ==== > /dev/kmsg; logcat -b all -d -t 300 | while read -r l; do echo $$l > /dev/kmsg; done; echo ==== DEBUG-PANIC ps ==== > /dev/kmsg; ps -A -o PID,PPID,STAT,WCHAN,ARGS | while read -r l; do echo $$l > /dev/kmsg; done; echo ==== DEBUG-PANIC bootprof ==== > /dev/kmsg; cat /proc/bootprof | while read -r l; do echo $$l > /dev/kmsg; done; echo ==== DEBUG-PANIC crash ==== > /dev/kmsg; echo c > /proc/sysrq-trigger; }"
